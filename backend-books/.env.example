# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Books
DATABASE_NAME=books_toscrape

# JWT Configuration
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here

# Allowed origins for CORS (comma-separated URLs, or * for all)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://your-frontend-app.vercel.app
